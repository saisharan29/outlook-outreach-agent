# ---- Agent core -------------------------------------------------------------
LLM_PROVIDER=anthropic             # anthropic (Claude) | openai (ChatGPT API key) | gemini (Google AI Studio key, free tier). One key is enough.
ANTHROPIC_API_KEY=                 # optional: request understanding + web research. Without any key the owner types addresses.
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=                    # used when LLM_PROVIDER=openai (key from https://platform.openai.com/api-keys)
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=                    # used when LLM_PROVIDER=gemini (key from https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODE=pipeline                # pipeline (rules run the steps, default) | agent (Claude drives the tools)

# ---- Microsoft (Azure "App registration", free) -------------------------------
# Permissions to grant: offline_access, User.Read, Mail.ReadWrite, Files.ReadWrite. NOT Mail.Send.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common                   # common = business or personal account; consumers = personal Outlook.com only
MS_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback

# ---- Files ------------------------------------------------------------------------
FILE_SOURCE=local                  # local (folder on this machine / synced OneDrive folder) | onedrive (through Graph)
AGENCY_ROOT=./Agency               # local path, or the OneDrive path (e.g. Agency) when FILE_SOURCE=onedrive
ONEDRIVE_PATH=                     # with FILE_SOURCE=local on a OneDrive-synced folder: its path inside OneDrive, e.g. Agency
MAX_ATTACHMENT_MB=20               # above this a video is linked, not attached
REGISTRY_MAX_AGE_DAYS=90           # contact details older than this are re-checked

# ---- Research -----------------------------------------------------------------------
DEFAULT_COUNTRY=LU                 # phone numbers are read with this region (LU mobiles: 621 / 661 / 691)
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,de,lb       # the languages the templates exist in (fr, de, lb, en)
TIMEZONE=Europe/Luxembourg         # "Bonjour" before 18:00, "Bonsoir" after
CC_RECIPIENTS=                     # always in copy of every draft, comma-separated (e.g. sean@…, alex@…)
SEARCH_PROVIDER=anthropic          # anthropic (Claude web search, no extra key) | brave | serpapi | none
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=             # optional: Google Business profile phone numbers

# ---- WhatsApp (section 6 of the spec): B + C by default; set a validator for option A ----
WHATSAPP_VALIDATOR_URL=
WHATSAPP_VALIDATOR_KEY=

# ---- Web app ----------------------------------------------------------------------------
APP_PASSWORD=change-me             # the owner's password for the chat
SECRET_KEY=change-me-long-random   # signs cookies and encrypts the stored Microsoft token
PUBLIC_URL=http://localhost:8080
PORT=8080
HOST=127.0.0.1                     # this machine only. 0.0.0.0 = also the phone on the same Wi-Fi (or behind the HTTPS proxy)
ENVIRONMENT=development
# DEMO=1                           # drafts go to Registry/demo_drafts.json instead of Outlook
